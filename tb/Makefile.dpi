# VCS Makefile for fpga_core DPI-C co-simulation (FIFO-based)
# This Makefile builds and runs the testbench with Python co-simulation
#
# Waveform support:
#   make sim-ludp-full           - Batch sim (no waveform)
#   make sim-ludp-full-vcd       - VCD waveform (may work in sandbox)
#   make sim-ludp-full-vpd       - VPD waveform for DVE (needs non-sandbox)
#   make sim-ludp-full-fsdb      - FSDB waveform for Verdi (needs non-sandbox)
#
# NOTE: FSDB/VPD dumpers require /proc access and will segfault in
# sandboxed environments. Use VCD or run on a non-sandboxed machine.

# Testbench settings
TB_TOP = tb_fpga_core_dpi
DUT = fpga_core

# Directories
RTL_DIR = ../rtl
LIB_DIR = ../lib
ETH_RTL_DIR = $(LIB_DIR)/eth/rtl
AXIS_RTL_DIR = $(LIB_DIR)/eth/lib/axis/rtl

# Source files
VERILOG_SOURCES += dpi_fifo.sv
VERILOG_SOURCES += $(RTL_DIR)/ludp_protocol.sv
VERILOG_SOURCES += $(RTL_DIR)/icmp_echo_reply.sv
VERILOG_SOURCES += $(RTL_DIR)/$(DUT).v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_mac_10g_fifo.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_mac_10g.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/axis_xgmii_rx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/axis_xgmii_tx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_rx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_rx_if.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_rx_frame_sync.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_rx_ber_mon.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_rx_watchdog.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_tx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_phy_10g_tx_if.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/xgmii_baser_dec_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/xgmii_baser_enc_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/lfsr.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_axis_rx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_axis_tx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/udp_complete_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/udp_checksum_gen_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/udp_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/udp_ip_rx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/udp_ip_tx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/ip_complete_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/ip_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/ip_eth_rx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/ip_eth_tx_64.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/ip_arb_mux.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/arp.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/arp_cache.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/arp_eth_rx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/arp_eth_tx.v
VERILOG_SOURCES += $(ETH_RTL_DIR)/eth_arb_mux.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/arbiter.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/priority_encoder.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/axis_fifo.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/axis_async_fifo.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/axis_async_fifo_adapter.v
VERILOG_SOURCES += $(AXIS_RTL_DIR)/sync_reset.v

# Testbench
VERILOG_SOURCES += $(TB_TOP).v

# C source for DPI
DPI_C_SOURCES = dpi_safe.c

# VCS settings
VCS = vcs
# Base flags: no -kdb to avoid Verdi PLI auto-link (causes segfault in sandbox)
VCS_BASE_FLAGS = -full64 -sverilog -timescale=1ns/1ps \
    -debug_access+all \
    +v2k \
    +libext+.v+.sv \
    -CFLAGS "-DVCS" \
    -f filelist_dpi.f \
    -top $(TB_TOP) \
    -o simv_dpi

# FSDB/Verdi compile flags (adds -kdb for KDB database)
# NOTE: Must run with VERDI_HOME set on a non-sandboxed machine
VCS_FSDB_FLAGS = -full64 -sverilog -timescale=1ns/1ps \
    -debug_access+all -kdb \
    +v2k \
    +libext+.v+.sv \
    -CFLAGS "-DVCS" \
    -f filelist_dpi.f \
    -top $(TB_TOP) \
    -o simv_dpi

# DPI compilation flags
DPI_FLAGS = -LDFLAGS "-Wl,--no-as-needed" \
    $(DPI_C_SOURCES)

# Simulation executable
SIMV = ./simv_dpi

# Python client
PYTHON_CLIENT = ../sw/ludp_host_fifo.py

.PHONY: all compile compile-vcd compile-vpd compile-fsdb \
        sim sim-arp sim-icmp sim-ludp-start sim-ludp-credit sim-ludp-full \
        sim-ludp-full-vcd sim-ludp-full-vpd sim-ludp-full-fsdb \
        clean

all: sim

# Generate filelist
filelist_dpi.f: Makefile.dpi
	@echo "Generating filelist..."
	@rm -f filelist_dpi.f
	@for f in $(VERILOG_SOURCES); do echo "$$f" >> filelist_dpi.f; done

# Compile targets (different waveform defines)
compile: filelist_dpi.f
	$(VCS) $(VCS_BASE_FLAGS) $(DPI_FLAGS)

compile-vcd: filelist_dpi.f
	$(VCS) $(VCS_BASE_FLAGS) +define+VCD_DUMP $(DPI_FLAGS)

compile-vpd: filelist_dpi.f
	$(VCS) $(VCS_BASE_FLAGS) +define+VPD_DUMP $(DPI_FLAGS)

compile-fsdb: filelist_dpi.f
	$(VCS) $(VCS_FSDB_FLAGS) +define+FSDB_DUMP $(DPI_FLAGS)

# --- Packet generation helper ---
define gen_packets
	@rm -rf /tmp/ludp_dpi_fifo
	@python3 $(PYTHON_CLIENT) --packet-type $(1)
endef

# --- Basic simulation targets (no waveform) ---

sim-arp: compile
	@echo "========================================"
	@echo "Running DPI-C simulation with ARP"
	@echo "========================================"
	$(call gen_packets,arp)
	$(SIMV) -no_save

sim-icmp: compile
	@echo "========================================"
	@echo "Running DPI-C simulation with ICMP"
	@echo "========================================"
	$(call gen_packets,icmp)
	$(SIMV) -no_save

sim-ludp-start: compile
	@echo "========================================"
	@echo "Running DPI-C simulation with LUDP START"
	@echo "========================================"
	$(call gen_packets,ludp_start)
	$(SIMV) -no_save

sim-ludp-credit: compile
	@echo "========================================"
	@echo "Running DPI-C simulation with LUDP CREDIT"
	@echo "========================================"
	@rm -rf /tmp/ludp_dpi_fifo
	@python3 $(PYTHON_CLIENT) --packet-type ludp_start
	@python3 $(PYTHON_CLIENT) --packet-type ludp_credit
	$(SIMV) -no_save

sim-ludp-full: compile
	@echo "========================================"
	@echo "Running DPI-C simulation with full LUDP"
	@echo "========================================"
	$(call gen_packets,ludp_full)
	$(SIMV) -no_save

# --- Waveform simulation targets ---

# VCD waveform (simplest format, may work in sandbox)
sim-ludp-full-vcd: compile-vcd
	@echo "========================================"
	@echo "Running DPI-C simulation with VCD waveform"
	@echo "========================================"
	$(call gen_packets,ludp_full)
	$(SIMV) -no_save -l sim-ludp-full-vcd.log
	@if [ -f simv_dpi.vcd ]; then \
		echo ""; \
		echo "VCD waveform generated: simv_dpi.vcd"; \
		echo "View with: gtkwave simv_dpi.vcd &"; \
		echo "Or convert for Verdi: vcd2fsdb simv_dpi.vcd simv_dpi.fsdb"; \
	else \
		echo "WARNING: VCD file not generated."; \
	fi

# VPD waveform for DVE (needs non-sandboxed environment)
sim-ludp-full-vpd: compile-vpd
	@echo "========================================"
	@echo "Running DPI-C simulation with VPD waveform"
	@echo "NOTE: VPD may segfault in sandboxed environments"
	@echo "========================================"
	$(call gen_packets,ludp_full)
	$(SIMV) -no_save -l sim-ludp-full-vpd.log || true
	@if [ -f simv_dpi.vpd ]; then \
		echo ""; \
		echo "VPD waveform generated: simv_dpi.vpd"; \
		echo "View with: dve -vpd simv_dpi.vpd &"; \
	else \
		echo "WARNING: VPD file not generated (sandbox /proc restriction)."; \
		echo "Run on a non-sandboxed machine for VPD support."; \
	fi

# FSDB waveform for Verdi (needs non-sandboxed environment)
# Run this on a machine with full /proc access and VERDI_HOME set
sim-ludp-full-fsdb: compile-fsdb
	@echo "========================================"
	@echo "Running DPI-C simulation with FSDB waveform"
	@echo "========================================"
	$(call gen_packets,ludp_full)
	$(SIMV) -no_save -l sim-ludp-full-fsdb.log || true
	@if [ -f simv_dpi.fsdb ]; then \
		echo ""; \
		echo "FSDB waveform generated: simv_dpi.fsdb"; \
		echo "View with: verdi -ssf simv_dpi.fsdb -dbdir simv_dpi.daidir &"; \
	else \
		echo ""; \
		echo "FSDB file not generated."; \
		echo "This is expected in sandboxed environments (no /proc access)."; \
		echo ""; \
		echo "To generate FSDB on a non-sandboxed machine:"; \
		echo "  1. export VERDI_HOME=/path/to/verdi"; \
		echo "  2. make -f Makefile.dpi clean"; \
		echo "  3. make -f Makefile.dpi sim-ludp-full-fsdb"; \
	fi

# Default simulation (no waveform)
sim: compile
	@echo "========================================"
	@echo "Starting DPI-C simulation"
	@echo "========================================"
	@echo "Generate packets with: python3 $(PYTHON_CLIENT) --packet-type <type>"
	@echo ""
	@rm -rf /tmp/ludp_dpi_fifo
	$(SIMV) -no_save

# Clean
clean:
	rm -rf simv_dpi simv_dpi.daidir csrc
	rm -rf vc_hdrs.h .vlogansetup.args .vlogansetup.env
	rm -f filelist_dpi.f
	rm -f *.vpd *.vcd *.fsdb
	rm -rf verdiLog novas* *.rc
	rm -f ucli.key
	rm -rf AN.DB
	rm -f sim-*.log
	rm -rf DVEfiles
	rm -rf /tmp/ludp_dpi_fifo
